<% for(var i=0; i<list.files.length; i++) {%>
  <a class="relative p-4" href="/view/<%= list.files[i].pageId %>">
    <img class="max-w-full sm:max-w-sm" src="<%= list.files[i].filename %>"/>
    <div class="absolute bottom-4 text-lg bg-white">by <%= list.files[i].author %></div>
  </a>
<% } %>

<% if (list.more) { %>
  <div hx-trigger="revealed" hx-swap="outerHTML" hx-get="/next?start=<%= list.next %>"></div>
<% } %>
