<meta charset="utf-8" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<link rel="icon" href="/public/favicon16.ico" sizes="16x16">
<link rel="icon" href="/public/favicon32.ico" sizes="32x32">
<meta
  name="description"
  content="card.glitches.me"
/>
<meta name="robots" content="index,follow" />

<meta name="twitter:card" content="summary" />
<meta property="og:type" content="platform" />

<% if (metadata) { %>
  <meta property="og:title" content="<%= metadata.title %>" />
  <meta property="og:url" content="https://card.glitches.me/" />
  <meta property="og:image" content="<%= metadata.image %>">
  <meta
    property="og:description"
    content="Card <%= metadata.title %>"
  />
  
  <title><%= metadata.title %></title>
<% } else { %>
  <meta property="og:title" content="card.glitches.me" />
  <meta property="og:url" content="https://card.glitches.me" />
  <meta property="og:image" content="https://card.glitches.me/public/cards-card.jpg">
  <meta
    property="og:description"
    content="Digital/physical hybrid platform for artists to share their cards"
  />
  
  <title>card.glitches.me</title>
<% } %>

<link href="/public/output.css" rel="stylesheet">
