<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head'); %>
</head>
<body>
<div class="flex justify-center w-full">

<main class="relative flex flex-col h-full max-w-lg w-full">
  <h1 class="text-3xl font-bold">
    Tag: <%= tag %>
  </h1>

  <%= message %>

  <% for(var i=0; i<list.length; i++) {%>
    <a class="relative" href="/view/<%= list[i].pageId %>">
      <img class="max-w-sm" src="<%= list[i].filename %>"/>
      <!-- <div class="absolute bottom-0 text-lg bg-white/75">by <%= list[i].pageId %></div> -->
    </a>
  <% } %>

  <%- include('../partials/footer') %>

  <div class="my-12"></div>
</main>

<script></script>

</div>
</body>
</html>
