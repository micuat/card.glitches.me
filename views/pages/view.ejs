<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head'); %>
</head>
<body>
<div class="flex justify-center w-full">

<main class="relative flex flex-col h-full max-w-lg w-full">
  <h1 class="text-3xl font-bold">
    View <%= pageId %>
  </h1>

  <div class="text-lg">
    by <%= metadata.author %> 
   
    <% if (metadata.remixPageId) { %>
      (remix of <a href="/view/<%= metadata.remixPageId %>" class="underline"><%= metadata.remixPageId %></a>)
    <% } %>
  </div>

  <a href="/new?remix=<%= pageId %>" class="font-bold underline">Remix this</a>

  <img class="max-w-xl" src="<%= filename %>" />

  
  <a href="/" class="font-bold underline">Back to top page</a>

  <div class="my-12"></div>
</main>

<script></script>

</div>
</body>
</html>
