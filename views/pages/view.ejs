<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head'); %>
</head>
<body>
<div class="flex justify-center w-full">

<main class="relative flex flex-col h-full max-w-lg w-full">
  <h1 class="text-3xl font-bold">
    View <%= pageId %>
  </h1>

  <%- metadata.linkView %>

  <img class="max-w-xl" src="<%= filename %>" alt="<%= metadata.ocr %>" />

  <% metadata.morePaths.forEach(function(path) { %>
    <img class="max-w-xl" src="/uploads/<%= path %>" alt="additional image" />
  <% }); %> 

  <a href="/edit/<%= pageId %>" class="font-bold underline">Edit</a>
  <a href="/expr/<%= pageId %>" class="font-bold underline">Experiment</a>
  <!-- <button class="bg-grey-500" onclick="downloadPNG()">download</button> -->

  <%- include('../partials/footer') %>

  <div class="my-12"></div>
  <div>debug info</div>
  <div><%= metadata.ocr %></div>
</main>

<script></script>

</div>
</body>
</html>
