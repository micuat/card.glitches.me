<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head'); %>
  <script src="https://cdn.jsdelivr.net/npm/p5@2.3.4/lib/p5.js"></script>
  <style>
:root {
  --margin: 40px;
}

html,
body {
  margin: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  touch-action: none;
}

* {
  user-select: none;
  -webkit-user-select: none;
  -webkit-touch-callout: none;
}

body {
  background: #111;
}

#canvas-area {
  box-sizing: border-box;
  width: 100vw;
  height: 100svh;
  padding: var(--margin);
  display: grid;
  place-items: center;
  touch-action: none;
}

#stage {
  position: relative;
  width: min(
    100%,
    calc((100svh - 2 * var(--margin)) * 1669 / 2520)
  );
  aspect-ratio: 1669 / 2520;
}

#stage img,
#stage canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

#stage img {
  object-fit: fill;
  pointer-events: none;
}

#stage canvas {
  position: absolute;
  inset: 0;
  z-index: 1;

  width: 100% !important;
  height: 100% !important;

  display: block;
  pointer-events: auto;
  touch-action: none;
}

#undo {
  position: absolute;
  left: calc(1270 / 1669 * 100%);
  top: calc(2040 / 2520 * 100%);
  width: calc(346 / 1669 * 100%);
  height: calc(180 / 2520 * 100%);
}

#submit {
  position: absolute;
  left: calc(1270 / 1669 * 100%);
  top: calc(2246 / 2520 * 100%);
  width: calc(346 / 1669 * 100%);
  height: calc(180 / 2520 * 100%);
}

button {
  z-index: 3;
  padding: 0;
  border: 0;
  background-color: lightgray;
  color: black;
  touch-action: none;
}
  </style>
</head>
<body>
<div class="flex justify-center w-full">

  <main id="canvas-area">
    <div id="stage">
      <!-- <img src="/public/template.png" alt="Card" /> -->
      <button id="undo" type="button" aria-label="Undo">UNDO</button>
      <button id="submit" type="button" aria-label="Undo">SUBMIT</button>
    </div>
</main>

<script>
let canvas;
let path = null;
let drawing = false;
let img;
const pathes = [];

async function setup() {
  img = await loadImage('/public/template.png');

  canvas = createCanvas(1669, 2520).parent("stage");
  pixelDensity(1);

  canvas.elt.addEventListener("pointerdown", startDrawing);
  canvas.elt.addEventListener("pointermove", drawPointer);
  canvas.elt.addEventListener("pointerup", stopDrawing);
  canvas.elt.addEventListener("pointercancel", stopDrawing);
  const undoButton = document.getElementById("undo");

  undoButton.addEventListener("click", undoStroke);
  
  function undoStroke(event) {
    event.preventDefault();
  
    // Cancel an active stroke
    drawing = false;
    path = null;
  
    // Remove the current/last stroke
    pathes.pop();
  }
}

function getPosition(event) {
  const r = canvas.elt.getBoundingClientRect();

  return {
    x: (event.clientX - r.left) * width / r.width,
    y: (event.clientY - r.top) * height / r.height
  };
}

function startDrawing(event) {
  event.preventDefault();

  const p = getPosition(event);

  path = [[p.x, p.y]];
  pathes.push(path);
  drawing = true;

  canvas.elt.setPointerCapture(event.pointerId);
}

function drawPointer(event) {
  if (!drawing) return;

  event.preventDefault();

  const p = getPosition(event);
  path.push([p.x, p.y]);
}

function stopDrawing(event) {
  event.preventDefault();
  drawing = false;
  path = null;
}

function draw() {
  clear();
  image(img, 0, 0, width, height);

  noFill();
  stroke(0);
  strokeWeight(5);

  for (const points of pathes) {
    beginShape();

    for (const p of points) {
      vertex(p[0], p[1]);
    }

    endShape();
  }
}
</script>

</div>
</body>
</html>
