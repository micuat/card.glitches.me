<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head'); %>
  <script src="https://cdn.jsdelivr.net/npm/p5@2.3.4/lib/p5.js"></script>
  <style>
:root {
  --margin: 40px;
}

html,
body {
  margin: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  touch-action: none;
}

* {
  user-select: none;
  -webkit-user-select: none;
  -webkit-touch-callout: none;
}

body {
  background: #111;
}

#canvas-area {
  box-sizing: border-box;
  width: 100vw;
  height: 100svh;
  padding: var(--margin);
  display: grid;
  place-items: center;
  touch-action: none;
}

#stage {
  position: relative;
  width: min(
    100%,
    calc((100svh - 2 * var(--margin)) * 1669 / 2520)
  );
  aspect-ratio: 1669 / 2520;
}

#stage img,
#stage canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

#stage img {
  object-fit: fill;
  pointer-events: none;
}

#stage canvas {
  position: absolute;
  inset: 0;
  z-index: 1;

  width: 100% !important;
  height: 100% !important;

  display: block;
  pointer-events: auto;
  touch-action: none;
}

#back {
  position: absolute;
  bottom: -1rem;
  left: 1rem;
  width: calc(346 / 1669 * 100%);
  height: calc(180 / 2520 * 100%);
}

#undo {
  position: absolute;
  bottom: -1rem;
  left: calc(50% - 173 / 1669 * 100%);
  width: calc(346 / 1669 * 100%);
  height: calc(180 / 2520 * 100%);
}

#submit {
  position: absolute;
  bottom: -1rem;
  right: 1rem;
  width: calc(346 / 1669 * 100%);
  height: calc(180 / 2520 * 100%);
}

button {
  z-index: 3;
  padding: 0;
  border: 0;
  background-color: lightgray;
  color: black;
  touch-action: none;
}

#overlay-background {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: grid;
  place-items: center;
  background-color: rgba(0, 0, 0, 0.5);
  display: none;
}

#overlay {
  padding: 1rem;
  background-color: white;
  border-radius: 0.5rem;
  color: black;
  font-size: 1.5rem;
  font-weight: bold;
}

#author {
  background-color: lightgray;
}
  </style>
</head>
<body>
<div class="flex justify-center w-full">

  <main id="canvas-area">
    <div id="stage">
      <!-- <img src="/public/template.png" alt="Card" /> -->
      <button id="back" type="button" aria-label="Back">BACK</button>
      <button id="undo" type="button" aria-label="Undo">UNDO</button>
      <button id="submit" type="button" aria-label="Undo">SUBMIT</button>
      <div id="overlay-background">
        <div id="overlay">
          <div>
            Your name
            <input type="text" id="author" name="author" placeholder="..." />
          </div>
          <button id="overlay-submit" type="button">Submit</button>
          <button id="overlay-cancel" type="button">Cancel</button>
        </div>
      </div>
    </div>
</main>

<script>
let canvas;
let path = null;
let drawing = false;
let img;
const pathes = [];

let remixImage = "<%= remixImage %>";
let remixPageId = "<%= remixPageId %>";

let overlayBackground;

async function setup() {
  console.log(remixImage, remixPageId);
  if (remixImage != "") {
    img = await loadImage(remixImage);
  }

  canvas = createCanvas(1669, 2520).parent("stage");
  pixelDensity(1);

  const authorName = localStorage.getItem("authorName");
  document.querySelector("#author").value = authorName;

  canvas.elt.addEventListener("pointerdown", startDrawing);
  canvas.elt.addEventListener("pointermove", drawPointer);
  canvas.elt.addEventListener("pointerup", stopDrawing);
  canvas.elt.addEventListener("pointercancel", stopDrawing);

  const undoButton = document.getElementById("undo");
  undoButton.addEventListener("click", undoStroke);

  const backButton = document.getElementById("back");
  backButton.addEventListener("click", () => {
    if (document.referrer) {
      history.back();
    } else {
      window.location.href = "/";
    }
  });

  const submitButton = document.getElementById("submit");
  submitButton.addEventListener("click", promptAuthor);
  
  const finalSubmitButton = document.getElementById("overlay-submit");
  finalSubmitButton.addEventListener("click", submitCard);

  const finalCancelButton = document.getElementById("overlay-cancel");
  finalCancelButton.addEventListener("click", cancelCard);

  overlayBackground = document.getElementById("overlay-background");

  function undoStroke(event) {
    event.preventDefault();
  
    // Cancel an active stroke
    drawing = false;
    path = null;
  
    // Remove the current/last stroke
    pathes.pop();
  }

  function promptAuthor(event) {
    event.preventDefault();
    overlayBackground.style.display = "grid";
  }

  async function submitCard(event) {
    event.preventDefault();

    const authorName = document
      .getElementById("author")
      .value
      .trim();

    localStorage.setItem("authorName", authorName);

    if (!authorName) {
      alert("Please enter your name.");
      return;
    }

    const overlayBackground =
      document.getElementById("overlay-background");

    const blob = await new Promise((resolve) => {
      canvas.elt.toBlob(resolve, "image/png");
    });

    if (!blob) {
      alert("Could not create image.");
      return;
    }

    const formData = new FormData();

    formData.append("author", authorName);
    formData.append("remixPageId", remixPageId);
    formData.append(
      "cardimg",
      blob,
      `card-${Date.now()}.png`
    );

    try {
      const response = await fetch("/upload", {
        method: "POST",
        body: formData
      });

      // Your endpoint returns HTML, not JSON
      const result = await response.text();

      if (!response.ok) {
        throw new Error(result);
      }

      overlayBackground.style.display = "none";

      // Display the server response, or redirect as desired
      document.body.insertAdjacentHTML("beforeend", result);

      window.location.href = "/";
    } catch (error) {
      console.error("Upload failed:", error);
      alert("Upload failed. Please try again.");
    }
  }

  function cancelCard(event) {
    event.preventDefault();
    const overlayBackground = document.getElementById("overlay-background");
    overlayBackground.style.display = "none";
  }
}

function getPosition(event) {
  const r = canvas.elt.getBoundingClientRect();

  return {
    x: (event.clientX - r.left) * width / r.width,
    y: (event.clientY - r.top) * height / r.height
  };
}

function startDrawing(event) {
  event.preventDefault();

  const p = getPosition(event);

  path = [[p.x, p.y]];
  pathes.push(path);
  drawing = true;

  canvas.elt.setPointerCapture(event.pointerId);
}

function drawPointer(event) {
  if (!drawing) return;

  event.preventDefault();

  const p = getPosition(event);
  path.push([p.x, p.y]);
}

function stopDrawing(event) {
  event.preventDefault();
  drawing = false;
  path = null;
}

function draw() {
  background(255);

  noFill();
  strokeWeight(5);

  const D = 300;
  if (overlayBackground.style.display !== "grid") {
    if (img !== undefined) {
      push();
      tint(255, 50);
      image(img, 0, 0, width, height);
      pop();
    }
    else {
      push();
      stroke(200);
      translate(width / 2, height / 2);
      for (let i = 0; i * D < height / 2; i++) {
        line(-width / 2, i * D, width / 2, i * D);
        line(-width / 2, -i * D, width / 2, -i * D);
      }
      for (let i = 0; i * D < width / 2; i++) {
        line(i * D, -height / 2, i * D, height / 2);
        line(-i * D, -height / 2, -i * D, height / 2);
      }

      fill(200);
      noStroke();

      for (let i = 0; i * D < height / 2; i++) {
        for (let j = 0; j * D < width / 2; j++) {
          circle(j * D, i * D, 30);
          circle(-j * D, i * D, 30);
          circle(-j * D, -i * D, 30);
          circle(j * D, -i * D, 30);
        }
      }
      pop();
    }
  }

  stroke(0);

  for (const points of pathes) {
    beginShape();

    let i = 0;
    let cdist = 0;
    let lastP = points[0];
    for (const p of points) {
      splineVertex(p[0], p[1]);
      let d = dist(lastP[0], lastP[1], p[0], p[1]);
      cdist += d;
      if (cdist > D || i == 0) {
        push();
        fill(0);
        noStroke();
        circle(p[0], p[1], 30);
        pop();
      }
      cdist = cdist % D;
      lastP = p;
      i++;
    }

    endShape();
  }
}
</script>

</div>
</body>
</html>
