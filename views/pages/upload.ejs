<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head'); %>
</head>
<body class="container">

<main>
  <h1 class="text-3xl font-bold underline">
    View <%= pageId %>
  </h1>

  <form class="p-1 flex flex-row" hx-post="/upload/<%= pageId %>" hx-target="#response" hx-swap="beforeend" hx-on::after-request="this.reset()">
    <input type="submit" hidden />
    <div class="w-full">
      <label class="">Author</label>
      <input class="border-2 border-sky-500 w-full" type="text" name="author" placeholder="...">
    </div>
    <button class="border-2 border-black">Submit</button>
  </form>
  <div id="response" class="">

  </div>
</main>

<script></script>

</body>
</html>