<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head'); %>
</head>
<body>
<div class="flex justify-center w-full">

<main class="relative flex flex-col h-full max-w-lg w-full z-0">
  <h1 class="text-3xl font-bold">
    Upload the card!
  </h1>

  <form class="p-1 flex flex-col space-y-4" method="post" enctype="multipart/form-data"
    hx-post="/upload" hx-target="#response" hx-swap="innerHTML" hx-on::after-request="resetAfterRequest()"
    hx-disabled-elt="find input[type='text'], find button">
    <input type="submit" hidden />
    <div class="w-full flex flex-row space-x-2">
      <label class="font-bold">Author</label>
      <input id="author" class="border-2 border-sky-500 w-full invalid:border-red-500 rounded-none"
        type="text" name="author" placeholder="...">
    </div>
    <div class="w-full mb-8 flex flex-col">
      <label for="cardimg" class="font-bold">Card Photo </label>
      <input type="file" id="cardimg" name="cardimg" accept="image/png, image/jpeg"
        class="file:mr-4 file:border-2 file:border-sky-500 file:px-4 file:py-2 file:rounded-none
          file:text-sm file:font-semibold hover:file:bg-gray-70 invalid:file:border-red-500""/>
    </div>
    <div class="w-full mb-8 flex flex-col">
      <label for="moreimg">More Photos (optional) </label>
      <input type="file" id="moreimg" name="moreimg" accept="image/png, image/jpeg" multiple
        class="file:mr-4 file:border-2 file:border-sky-500 file:px-4 file:py-2 file:rounded-none
          file:text-sm file:font-semibold hover:file:bg-gray-70 invalid:file:border-red-500""/>
    </div>
    <button id="submit-button" class="border-2 border-sky-500 py-8 hover:bg-gray-70 disabled:bg-gray-50 disabled:border-gray-500 rounded-none font-bold">
      Submit
      <img id="spinner" class="htmx-indicator w-6 h-6 inline" src="/public/spinner.gif"/>
    </button>
    <input type="reset" value="Reset"
      class="border-2 border-sky-500 py-2 hover:bg-gray-70 disabled:bg-gray-50 rounded-none">
    </input>
    <div id="response" class="min-h-8">
    </div>
    <div>By submitting the card, you agree to share it under <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank">Creative Commons Attribution-ShareAlike 4.0 International</a> license.</div>
  </form>

  <%- include('../partials/footer') %>
</main>

<script>
  const authorName = localStorage.getItem("authorName");
  document.querySelector("#author").value = authorName;

  document.querySelector("#submit-button").disabled = authorName === null;
  document.querySelector("#author").oninput = function (e) {
    const authorName = e.target.value;
    document.querySelector("#submit-button").disabled = authorName === "";
  }

  function resetAfterRequest() {
    const authorName = document.querySelector("#author").value;
    console.log(authorName)
    localStorage.setItem("authorName", authorName);
    document.querySelector("form").reset();
    document.querySelector("#author").value = authorName;
  }

  document.body.addEventListener('htmx:beforeSwap', function(evt) {
    if(evt.detail.xhr.status === 400){
        evt.detail.shouldSwap = true;
    }
  });
</script>

</div>
</body>
</html>
