<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head'); %>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/p5.js/1.11.1/p5.js"></script>
</head>
<body>
<div class="flex justify-center w-full">

<main class="relative flex flex-col h-full max-w-lg w-full">
  <h1 class="text-3xl font-bold">
    View <%= pageId %>
  </h1>

  <!-- <img class="max-w-xl" src="<%= filename %>" alt="<%= metadata.ocr %>" /> -->
  <div class="relative max-w-xl p5-insert"></div>

  <a href="/edit/<%= pageId %>" class="font-bold underline">Edit</a>
  <a href="/view/<%= pageId %>" class="font-bold underline">Normal</a>
  <!-- <button class="bg-grey-500" onclick="downloadPNG()">download</button> -->

  <%- include('../partials/footer') %>

  <div class="my-12"></div>
  <div>debug info!!</div>
  <div><%= metadata.ocrRaw %></div>
</main>

<script>
let img;
let json = <%- metadata.ocrRaw %>
let canvas;
function preload() {
  // img = loadImage("https://card.glitches.me/uploads/1744296836783-IMG_5562.jpeg");
  img = loadImage("<%= filenameRaw %>");
  
}

function setup() {
  const w = Math.min(window.innerWidth, 32 * 16);
  canvas = createCanvas(w, img.height / img.width * w)
  canvas.parent(select(".p5-insert"));
}


function draw() {
  let firstLine = true;
  background(255);

  const scaleFactor = width / img.width;
  scale(scaleFactor);

  image(img, 0, 0)

  textAlign(LEFT, TOP);

  if (json.blocks !== undefined) {
    for (const block of json.blocks) {
      for (const line of block?.lines) {
        fill(255,240)
        noStroke()
        beginShape(QUADS)
        vertex(line.boundingPolygon[0].x, line.boundingPolygon[0].y, 20)
        vertex(line.boundingPolygon[1].x, line.boundingPolygon[1].y, 20)
        vertex(line.boundingPolygon[2].x, line.boundingPolygon[2].y, 20)
        vertex(line.boundingPolygon[3].x, line.boundingPolygon[3].y, 20)
        endShape(CLOSE)

        const a = Math.atan2(
          line.boundingPolygon[1].y +
            line.boundingPolygon[2].y -
            (line.boundingPolygon[0].y + line.boundingPolygon[3].y),
          line.boundingPolygon[1].x +
            line.boundingPolygon[2].x -
            (line.boundingPolygon[0].x + line.boundingPolygon[3].x)
        );

        const fontSize = dist(
          line.boundingPolygon[0].x,
          line.boundingPolygon[0].y,
          line.boundingPolygon[3].x,
          line.boundingPolygon[3].y
        ) * 1
        const boundWidth = dist(
          line.boundingPolygon[0].x,
          line.boundingPolygon[0].y,
          line.boundingPolygon[1].x,
          line.boundingPolygon[1].y
        )
        // const w = textWidth(line.text);
        // scale(
        //   dist(
        //     line.boundingPolygon[0].x,
        //     line.boundingPolygon[0].y,
        //     line.boundingPolygon[1].x,
        //     line.boundingPolygon[1].y
        //   ) / w,
        //   1
        // );

        let s;
        if (line.text.startsWith("#")) {
          s = createA(`https://duckduckgo.com/?q=${line.text.slice(1)}`, line.text, "_blank");
        }
        else {
          s = createSpan(line.text);
        }
        s.parent(select(".p5-insert"));
        s.position(
          line.boundingPolygon[0].x * scaleFactor, line.boundingPolygon[0].y * scaleFactor
        );
        s.style("z-index", "10");
        s.style("overflow", "hidden");
        s.style("font-size", `${fontSize * scaleFactor}px`);
        s.style("transform", `rotate(${a}rad) scale(${(boundWidth * scaleFactor)/s.elt.clientWidth}, 1)`);
        s.style("transform-origin", "top left");
        s.style("text-wrap", "nowrap");
        s.style("font-family", "Arial, sans-serif");
        // s.style("background-color", "white");
        if (firstLine) {
          // s.style("background-color", "black");
          // s.style("color", "white");
          s.style("font-weight", "bold");
        } else if (line.text.startsWith("#")) {
          s.style("font-family", "Courier, monospace");
          s.style("color", "blue");
          s.style("text-decoration", "underline");
        } else {
        }

        firstLine = false;
      }
    }
  }

  noLoop();
}

// function draw() {
//   background(220);
// }
</script>

</div>
</body>
</html>
